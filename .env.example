# Copia este archivo como .env y llena tus valores. El .env nunca se sube al repositorio.

# Llave de Google Maps (Maps SDK for Android, Directions, Places y Geocoding). La usan el mapa nativo
# (Gradle la pone en el AndroidManifest al compilar) y las búsquedas de direcciones.
# Restríngela en Google Cloud al paquete de la app y a esas APIs.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Dirección del backend. Desde un emulador o un celular usa la IP de tu PC en la red Wi-Fi.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000

# ID de cliente "Aplicación web" de Google Cloud, para entrar con Google (el mismo GOOGLE_WEB_CLIENT_ID del backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=tu_id.apps.googleusercontent.com
